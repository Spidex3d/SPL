mod Add(a, b);
       return a + b;
modEnd();

mod multi(a, b);
       return a * b;
modEnd();

// Entery point
mod main(); 
     dec_i x = Add(2, 3);
     dec_i age = multi(2,  34);
     dec_s name = "Martyn";
     pout "x = " + x;
     pout "Age is " + age;
     pout "Hi " + name + " Your age is: " + age;
modEnd();



