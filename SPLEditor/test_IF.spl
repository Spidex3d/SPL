#import "std.splh" 

mod main();
    dec_b a = true;
    dec_b b = false;

    IfIts (!a && b)
        pout "Condition a is true and b is FALSE";
    Else
        pout "Condition failed";
    EndIfIts;

     IfIts ((a && !b) || (a isEqual 1))
     pout "Complex condition TRUE";
     EndIfIts;

   dec_i x = 5;
   dec_b flag = false;

    IfIts (flag)
        pout "flag is TRUE";
    ElseIts (flag isEqual 0)
        pout "flag is FALSE";
    Else
        pout "flag is something else";
    EndIfIts;

    pout "Flag is " + flag;
    pout flag;

    StdHello();
    dec_s name = StdGetName();
    pout "Name from std: " + name;
modEnd();