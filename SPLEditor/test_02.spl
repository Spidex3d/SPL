runIt()   // main loop  bool

loopIt(int i = 0; i < (int)gToolbar.size(); ++i)   // Replacment for for loop
   

isIt 0 (!sourceFileStream)  // replacment for if statment
    pout "File not found!";
    endIt;

    isIt 1
    pout "File not found!";
    endIt

    isIt 2
    pout "File not found!";
    endIt;

endloopIt

moveTo(index) {  //Replaces  switch case
    
    move 0:
    move 1:
    move 2:
    move 3:
    }


run_It_end	// End main Loop

