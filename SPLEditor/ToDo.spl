// This is a comment in spl langauge

<  isLess",	
>  isMore",	
>= isEqual",	
<= isNotEqual"

And &&   // logical operators
Or  ||   // logical operators
Not !    // unary operator this can have more added to it later

if (condition) { ... }  // if statment
else { ... }            // else statment)

IfIts  (condition)    // replacment for if statment
   pout "condition is true";
ElseIts (condition)  // replacment for else if statment
   pout "condition is true";
Else   // replacment for else statment
   pout "condition is true";
EndIfIts;

